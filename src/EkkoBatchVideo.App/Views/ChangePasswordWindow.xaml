<Window x:Class="EkkoBatchVideo.Views.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đổi mật khẩu"
        Width="420"
        Height="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FF101827"
        Foreground="White"
        FontFamily="Segoe UI"
        FontSize="13">
    <StackPanel Margin="28">
        <TextBlock Text="Đổi mật khẩu"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="#FF25D7E8"
                   Margin="0,0,0,8"/>
        <TextBlock Text="Nhập mật khẩu hiện tại và mật khẩu mới."
                   Foreground="#FFB5C2D6"
                   Margin="0,0,0,18"/>

        <TextBlock Text="Mật khẩu hiện tại" Foreground="White"/>
        <PasswordBox x:Name="Current"
                     Margin="0,5,0,12"
                     Padding="8"
                     Height="34"
                     KeyDown="Input_KeyDown"/>

        <TextBlock Text="Mật khẩu mới" Foreground="White"/>
        <PasswordBox x:Name="New"
                     Margin="0,5,0,12"
                     Padding="8"
                     Height="34"
                     KeyDown="Input_KeyDown"/>

        <TextBlock Text="Xác nhận mật khẩu mới" Foreground="White"/>
        <PasswordBox x:Name="Confirm"
                     Margin="0,5,0,16"
                     Padding="8"
                     Height="34"
                     KeyDown="Input_KeyDown"/>

        <Button Content="Lưu mật khẩu mới"
                Padding="10,8"
                Click="Save_Click"/>
        <TextBlock x:Name="Error"
                   Foreground="#FFFF8A8A"
                   TextWrapping="Wrap"
                   Margin="0,12,0,0"/>
    </StackPanel>
</Window>
