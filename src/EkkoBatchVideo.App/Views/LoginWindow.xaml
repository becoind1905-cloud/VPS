<Window x:Class="EkkoBatchVideo.Views.LoginWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Đăng nhập Ekko Tools" Width="560" Height="400" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#FF101827" Foreground="White">
  <StackPanel Margin="32">
    <TextBlock Text="Ekko Tools" FontSize="26" FontWeight="Bold" Foreground="#FF25D7E8"/>
    <TextBlock Text="Đăng nhập để sử dụng ứng dụng" Margin="0,6,0,22" Foreground="#FFB5C2D6"/>
    <TextBlock Text="Tài khoản"/><TextBox x:Name="EmailBox" Margin="0,4,0,10" Padding="8"/>
    <TextBlock Text="Mật khẩu"/><PasswordBox x:Name="PasswordBox" Margin="0,4,0,14" Padding="8"/>
    <StackPanel Orientation="Horizontal"><Button Content="Đăng nhập" Width="120" Padding="8" IsDefault="True" Click="Login_Click"/><Button Content="Đăng ký" Margin="8,0,0,0" Padding="8" Click="Register_Click"/><Button Content="Quên mật khẩu" Margin="8,0,0,0" Padding="8" Click="Forgot_Click"/></StackPanel>
    <TextBlock x:Name="ErrorText" Foreground="#FFFF8A8A" TextWrapping="Wrap" Margin="0,14,0,0"/>
  </StackPanel>
</Window>
